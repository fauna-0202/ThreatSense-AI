# ==============================================================================
# ThreatSense AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and customize values for your deployment.
# NEVER commit your actual '.env' file containing real secrets to version control.

# Application Settings
THREATSENSE_ENV=development                # 'development' | 'production' | 'testing'
THREATSENSE_DEBUG=true                      # Set to false in production environments
THREATSENSE_SECRET_KEY=replace-with-a-random-secure-secret-key-at-least-32-chars

# API & Authentication
THREATSENSE_API_HOST=127.0.0.1
THREATSENSE_API_PORT=8000
# API key used in X-API-Key header. In production, this MUST be set to a strong key.
THREATSENSE_API_KEY=replace-with-your-secure-api-key

# Database Connection (SQLite default; PostgreSQL compatible)
DATABASE_URL=sqlite:///./data/threatsense.db

# Storage & Artifact Paths
MODEL_ARTIFACTS_DIR=./artifacts/models
REPORTS_DIR=./artifacts/reports
SAMPLES_DIR=./data/samples

# Network Sensor Configuration
SENSOR_MODE=replay                          # 'replay' (offline demo) | 'live' | 'stopped'
ZEEK_BIN_PATH=zeek                          # Path to Zeek binary ('zeek' on Linux/WSL2)
ZEEK_INTERFACE=eth0                         # Authorized network interface for live capture
ZEEK_LOG_DIR=./sensor/zeek_logs             # Directory where Zeek conn.log is stored

# Risk & Uncertainty Operational Thresholds
RISK_THRESHOLD_MODERATE=25.0                # Threshold separating Low and Moderate bands
RISK_THRESHOLD_HIGH=50.0                    # Threshold separating Moderate and High bands
RISK_THRESHOLD_CRITICAL=75.0                # Threshold separating High and Critical bands
MIN_CONFIDENCE_THRESHOLD=0.60               # Below this confidence, triggers HIGH_UNCERTAINTY
EXPLAINABILITY_ENABLED=true                 # Enables per-event SHAP TreeExplainer attributions
